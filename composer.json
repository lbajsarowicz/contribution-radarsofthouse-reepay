{
    "name": "radarsofthouse/reepay",
    "description": "Frisbii Pay for Magento 2",
    "type": "magento2-module",
    "version": "1.2.73",
    "authors": [
        {
            "email": "info@radarsofthouse.dk",
            "name": "Radarsofthouse"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "guzzlehttp/guzzle": "~6.0|~7.0",
        "ext-intl": "*"
    },
    "autoload": {
        "psr-4": {
            "Radarsofthouse\\Reepay\\": ""
        },
        "files": [
            "registration.php"
        ]
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
